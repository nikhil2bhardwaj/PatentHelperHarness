# ============================================================================
# Patent Helper Harness — Environment Configuration
# ============================================================================

# Active Provider: "openai", "anthropic", "gemini", or "openaicompatible"
API_PROVIDER=openai

# 1. OpenAI (Default)
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 3. Google Gemini (via OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 4. OpenAI-Compatible (Ollama, vLLM, DeepSeek, Groq, LMStudio)
OPENAI_COMPATIBLE_API_KEY=your_key_or_placeholder
OPENAI_COMPATIBLE_MODEL=llama3.3:70b
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# General Hyperparameters
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
